+function renderAud(){const now=new Date(),keep=[fSrc,fDev,fOwn];fSrc="";fDev="";fOwn="";let M;try{M=build(AUD.start,new Date(+now+864e5))}finally{[fSrc,fDev,fOwn]=keep}
+ const affOf=s=>(s.aff||(s.p&&s.p.get("aff"))||"").toLowerCase(), who=s=>s.vid||s.sid, arms=(EXP.arms||[]).slice();
+ const lastRow=rows.length?rows[rows.length-1].t:null;
+ const sel=$("audSpCamp");if(!sel.options.length)sel.innerHTML=AUD.camps.map(c=>'<option value="'+c.code+'">'+esc(c.lbl+" · "+c.aud)+'</option>').join("");
