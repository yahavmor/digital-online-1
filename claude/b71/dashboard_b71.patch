+ const C={};AUD.camps.forEach(c=>C[c.code]=Object.assign(F(),{c,pg:{}}));
+ const scan=s=>s.ev.length&&s.ev.every(r=>/^meta_scan/.test(r.ev)); /* סריקות של Meta (ב22) לא נספרות כאן */
+ M.sess.forEach(s=>{const o=C[affOf(s)];if(!o||scan(s))return;const w=who(s),pk=arms.includes(s.v)?s.v:"__other";
+  [o,o.pg[pk]||(o.pg[pk]=F())].forEach(f=>{f.v++;f.ppl.add(w);if(s.sec>=2||s.secT[2]>0)f.p1.add(w);if(s.offer)f.off.add(w);if(s.chk)f.chk.add(w);(BS.get(s)||[]).forEach(b=>f.deals.add(b.deal))});
+  const k=s.cr||"";const r=o.cr[k]||(o.cr[k]={ppl:new Set(),chk:new Set(),deals:new Set()});r.ppl.add(w);if(s.chk)r.chk.add(w);(BS.get(s)||[]).forEach(b=>r.deals.add(b.deal))});
+ /* רכישה של משווק שלא נמצא לה ביקור (למשל העברה בנקאית) - נספרת בקמפיין, לא בדף */
+ M.buys.forEach(b=>{const o=C[(b.aff||"").toLowerCase()];if(o)o.deals.add(b.deal)});
+ const L=AUD.camps.map(c=>{const o=C[c.code];o.n=o.ppl.size;o.buy=o.deals.size;o.sp=audSpend(c.code);o.few=o.n<AUD.min;return o});
+ const nm=o=>'<b>'+esc(o.c.lbl)+'</b> · '+esc(o.c.aud)+'<small>'+esc((AFF[o.c.code]||{}).name||o.c.code)+'</small>'+(o.few?'<br><span class="na">מעט נתונים</span><small>'+fmt(o.n)+'/'+AUD.min+' כניסות</small>':'');
+ const money=(v,why)=>v!=null?ils(v):noData(why);
+ table($("audCamp"),["קמפיין","הוצאה","כניסות","עברו מסך ראשון","הגיעו להצעה","הגיעו לסליקה","רכישות","המרה","עלות לכניסה","עלות ללקוח משלם"],
+  L.map(o=>'<tr><td>'+nm(o)+'</td><td>'+(o.sp?ils(o.sp.t)+'<small>'+o.sp.days+' ימים</small>':noData("לא הוזנה הוצאה לקמפיין"))+'</td><td class="num">'+fmt(o.n)+'<small>'+fmt(o.v)+' ביקורים</small></td>'+cell(o.p1.size,o.n)+cell(o.off.size,o.n)+cell(o.chk.size,o.n)+'<td class="num">'+fmt(o.buy)+'</td>'+cell(o.buy,o.n)+'<td>'+money(o.sp&&o.n?o.sp.t/o.n:null,o.sp?"אין כניסות":"אין הוצאה")+'</td><td>'+money(o.sp&&o.buy?o.sp.t/o.buy:null,!o.buy?"אין רכישות":"אין הוצאה")+'</td></tr>'),"אין עדיין כניסות מהקמפיינים");
+ const pages=arms.concat(L.some(o=>o.pg.__other)?["__other"]:[]), pl=v=>v==="__other"?"דפים אחרים":esc(VLBL[v]||v);
+ const rowsP=[];L.forEach(o=>pages.forEach(v=>{const P=o.pg[v];if(!P)return;const n=P.ppl.size;rowsP.push('<tr><td>'+esc(o.c.lbl)+' · '+esc(o.c.aud)+'</td><td>'+(v==="__other"?"":'<i class="sw" style="background:'+(VCOL[v]||"var(--line)")+'"></i>')+pl(v)+'</td><td class="num">'+fmt(n)+'</td>'+cell(P.p1.size,n)+cell(P.off.size,n)+cell(P.chk.size,n)+'<td class="num">'+fmt(P.deals.size)+'</td>'+cell(P.deals.size,n)+'</tr>')}));
+ table($("audPage"),["קמפיין","דף","כניסות","עברו מסך ראשון","הגיעו להצעה","הגיעו לסליקה","רכישות","המרה"],rowsP,"אין עדיין כניסות מהקמפיינים");
+ const rowsV=[];L.forEach(o=>Object.keys(o.cr).sort((a,b)=>o.cr[b].ppl.size-o.cr[a].ppl.size).forEach(k=>{const r=o.cr[k],i=labInfo(k);rowsV.push('<tr><td>'+esc(o.c.lbl)+' · '+esc(o.c.aud)+'</td><td>'+(i.named?'<b>'+esc(i.name)+'</b>':'<b>'+esc(k||"(בלי קוד סרטון)")+'</b><small>לא בטבלת המעבדה</small>')+'</td><td>'+esc(i.copy||"-")+'</td><td class="num">'+fmt(r.ppl.size)+'</td>'+cell(r.chk.size,r.ppl.size)+'<td class="num">'+fmt(r.deals.size)+'</td></tr>')}));
