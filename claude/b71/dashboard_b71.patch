+ const [A,B2]=L, few=L.some(o=>o.few), tag=few?' <span class="na">מעט נתונים</span>':'';
+ const lead=(f,lbl,unit)=>{const a=f(A),b=f(B2);if(a==null||b==null)return lbl+': '+noData("חסר נתון לאחד הקמפיינים");if(a===b)return lbl+': שווה ('+unit(a)+')';const w=a>b?A:B2;return lbl+': <b>'+esc(w.c.lbl+" ("+w.c.aud+")")+'</b> · '+esc(A.c.lbl)+' '+unit(a)+' מול '+esc(B2.c.lbl)+' '+unit(b)};
+ const cheap=(f,lbl)=>{const a=f(A),b=f(B2);if(a==null||b==null)return lbl+': '+noData("חסרה הוצאה או שאין עדיין רכישות/כניסות");if(Math.round(a)===Math.round(b))return lbl+': דומה בשני הקמפיינים ('+ils(a)+')';const w=a<b?A:B2;return lbl+': זול יותר אצל <b>'+esc(w.c.lbl+" ("+w.c.aud+")")+'</b> · '+esc(A.c.lbl)+' '+ils(a)+' מול '+esc(B2.c.lbl)+' '+ils(b)};
+ const bestPage=o=>{const E=arms.filter(v=>o.pg[v]&&o.pg[v].ppl.size>0);if(E.length<2)return esc(o.c.lbl)+': '+noData("עדיין אין כניסות לשני הדפים");const sc=v=>{const P=o.pg[v];return P.deals.size/P.ppl.size*1e3+P.chk.size/P.ppl.size};const srt=E.slice().sort((x,y)=>sc(y)-sc(x));if(sc(srt[0])===sc(srt[1]))return esc(o.c.lbl+" ("+o.c.aud+")")+': עדיין אין הבדל בין הדפים';const w=srt[0],P=o.pg[w];return esc(o.c.lbl+" ("+o.c.aud+")")+': <b>'+esc(VLBL[w]||w)+'</b> · '+fmt(P.chk.size)+'/'+fmt(P.ppl.size)+' לסליקה, '+fmt(P.deals.size)+' רכישות'+(o.few?' <span class="na">מעט נתונים</span>':'')};
+ const pp=x=>pf(pct(x[0],x[1]))+' ('+fmt(x[0])+'/'+fmt(x[1])+')';
+ $("audSum").innerHTML=[lead(o=>o.n,"יותר כניסות",fmt),lead(o=>o.buy,"יותר רכישות",fmt),cheap(o=>o.sp&&o.n?o.sp.t/o.n:null,"עלות לכניסה"),cheap(o=>o.sp&&o.buy?o.sp.t/o.buy:null,"עלות ללקוח משלם"),
+  'P25 בקר מול חם, מעבר מסך ראשון: '+esc(A.c.lbl)+' '+pp([A.p1.size,A.n])+' מול '+esc(B2.c.lbl)+' '+pp([B2.p1.size,B2.n])+'; הגעה לסליקה: '+pp([A.chk.size,A.n])+' מול '+pp([B2.chk.size,B2.n]),
+  'הדף שממיר יותר: '+bestPage(A)+' · '+bestPage(B2)].map(x=>'<div>'+x+'</div>').join("")+(few?'<div><span class="na">מעט נתונים</span> עד '+AUD.min+' כניסות לכל קמפיין - הכיוון עוד יכול להתהפך.</div>':'');
+ $("audNote").innerHTML="מ-"+hm2(AUD.start)+" עד עכשיו"+tag;
+ $("audSrc").innerHTML='<b>מקורות:</b> כניסות, מסך ראשון, הצעה וסליקה - גיליון האירועים, לפי קוד המשווק בקישור (aff=shahar, aff=rachel; שורה אחרונה '+hm2(lastRow)+') · רכישות - אישור עסקה מקארדקום, משויכות למשווק · הוצאה - הזנה ידנית לפי מנהל המודעות (הטופס למטה) · שמות הסרטונים - טבלת המעבדה. התקופה קבועה מתחילת מ28 ולא לפי הבורר למעלה. בלי בדיקות ובלי סריקות של Meta.';
